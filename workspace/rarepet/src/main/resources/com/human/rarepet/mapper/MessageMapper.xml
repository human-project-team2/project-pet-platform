<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.human.rarepet.mapper.MessageMapper">

	<insert id="sendMessage" parameterType="MessageDto">
		insert into message (message_content, send_date, sender_id, receiver_id)
		values (#{messageContent}, #{sendDate}, #{senderId}, #{receiverId})
	</insert>
	
	<select id="receiveMessage" parameterType="String" resultType="MessageDto">
		select * from message where receiver_id = #{receiverId}
	</select>
</mapper>
